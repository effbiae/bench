#!/usr/bin/env python3
from plotnine import*;import os,json,sys;from scipy.stats import gmean;from pandas import *#;from subprocess import run;
want='suite imp memory cputime walltime returnvalue'.split()
t=read_csv(f"all.csv")[want].query("returnvalue==0")
a=t.groupby(['suite','imp']).agg({'walltime':['median'],'memory':['median'],'cputime':['median'],'returnvalue':['max']})
a.columns=[c[0]for c in a.columns];a=a.reset_index()
n=merge(a,a.query("returnvalue==0").groupby(['suite'])['walltime'].min(),on='suite')
n['norm']=n['walltime_x']/n['walltime_y']
n['walltime']=n['walltime_x']
n=n[want[:-1]+['norm']]
s=n.groupby('imp')['norm'].apply(gmean).sort_values()
n['imp']=Categorical(n['imp'],categories=s.index,ordered=True)
g = (
    n.groupby(['imp'])['norm']
    .agg(ymin='min', ymax='max',gmean=gmean)
    .reset_index()
)
print(g)
p=(ggplot(g, aes(x='imp',y='gmean'))
 + geom_errorbar(aes(ymin='ymin', ymax='ymax'), color='gray', width=0.2, size=1)
 + geom_point(size=3, color='gray')
 + theme_light()
 + labs(title="How many times slower? -- Min, Max and Geometric Mean",
        x="Language Implementation",
        y="Program elapsed seconds%fastest program")
 + scale_y_log10()
)
p.save(f'lead.svg')

