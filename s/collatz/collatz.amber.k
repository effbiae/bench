sh:{[y;k]d:*/k#2;e:_B%d;z[(_y%d)+e*d!1_y,0]};tb:{[b]w:{[y]0<y 1}{[y]$[2!y 0;(1+3*y 0;y 1;1+y 2);(_0.5*y 0;-1+y 1;y 2)]}/(b;8;0);(w 2;w 0)}
