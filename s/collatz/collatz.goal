/ Translated to goal from the k solution.
D:-B:*/32#2; Hd:-H:65536; P3:33(3*)\1; T3:3*T:64
(TR;TK):16{(a;k):x;(-2!a+(2!a)*1+2*a;k+2!a)}/(!H;H#0); TP:P3 TK
cr:{h:D!x; x:(B!x)+»h; ?[t:*|h;x,t;x]}
blk:{[s](x;c):s; w:B!x0:*x
 k:TK i:H!w; w:(TR i)+(TP i)*Hd!w; j:H!w; k+:TK j; w:(TR j)+(TP j)*Hd!w
 u:1_x; u[0]+:D!x0; u:?[k>19;(P3 k-19)*cr u*P3 19;u*P3 k]
 u[0]+:w; (cr u;c+32+k)}
mul:{[x;K]q:-19!K; cr(P3 K-19*q)*q{cr x*P3 19}/x}
bat:{[x;c](T3<#x)or:(x;c); (w;d):T blk/(cr(T+1)#x;c)
  x:0,mul[(T+1)_x;d-c+32*T]; x[!#w]+:w; ?[(T+1)<#w;x:cr x;0]
  o[x;d]}
tail:{(1<x)or:y; o[?[2!x;1+3*x;-2!x];y+1]}
f:{h:-2!x; s:mul[,1+2!x;h]; s[0]+:1
  (v;c):{1<#*x}blk/{(cr@*x;x 1)}bat[s;3*h]
  tail[*v;c]}
say f@"i"$(ARGS 1)or 32768
