#!/usr/bin/env goal
/implementations with executable name and file extensions
imp:..[gcc:("gcc";"c");growler:("k";"growler.k");python3:("python3";"py");goal:("goal";"goal");bqn:("bqn";"bqn")
       l:("l_l64";"l.k""l.q");amber:("amber";"amber.k");kap:("kap-jvm-text";"kap");peachq:("q";"peach.q")]
call:(!imp)!(" "/,)@'*'. imp;call["kap"]:{" "/(*imp["kap"];"--load="+x;"-n")};call["peachq"]:{" "/(*imp["peachq"];x;"-q")}
all:..[knucleotide:25 27;nbody:20 30;spectralnorm:9 25;collatz:18 19] /the ranges for n (size of input/argument to each benchmark)
rnd:"collatz""spectralnorm"
?[~"r1"in ARGS;rge:rnd#all;rge:rnd^all]
say rge;
gen:..[knucleotide:"fasta"] /what program generates input
gcco:"-pipe -Wall -O3 -fomit-frame-pointer -march=native -fopenmp"
bash:{say x;run"bash""-c",x}
corescmd:rq#cat $(find /sys/devices/system/cpu -regex ".*cpu[0-9]+/topology/thread_siblings_list") |sort -n |uniq |cut -d, -f1#
say"cores "+cores:","/=-bash corescmd
system:{?["e"~@x:bash x;(.x)..code;0]};isfile:{~"e"=@x:stat x};isdir:{(~"e"=@x:stat x)and x"dir"};assert:{?[~x;"fail"+1;x]}
rexcmd:{[t;input;output;argv]
 "runexec --walltimelimit ${t}s --memlimit 2GB  --cores $cores --input $input --output >(tail +7 >$output) -- $argv"}
rex:{[t;input;output;argv]{!/+"="\'=-x}bash rexcmd[t;input;output;argv]}

"imp.json"say""json imp /write imp for use in plot

?[isdir"o";::;mkdir"o"]
{(isfile"o/$x")or system"gcc $gcco s/$x/${x}.c -oo/$x"}'.gen /compile gcc programs

/generate input for benchmarks that need it
rg:{(*x)_!*|x};tmp:{-run"mktemp"};rm:{bash"rm "+x}
{[s;r]{[s|i]n:$*/i#2;(s in!gen)and [ogi:"o/"+gen[s]+"-$i";(isfile ogi)or rex[20;"/dev/null";ogi;"o/"+gen[s]+" $n"]]}'rg r}.'+(!;.)@`all

/run the python benchmarks with increasing n until python takes longer than tt (writes json to o/n)
tt:1(6*)\?["-t"in ARGS;"i"$ARGS 1+ARGS?"-t";30]
d:?[isfile["o/n"];"i"$json read"o/n";(0#"")!!0]
?[~#d
 [{[s;r]?[s in!d;:
  {[s|;x]n:*/x#2;inp:?[s in!gen;"o/"+gen[s]+"-$x";"/dev/null"];t:"o/$s-$x-check"
    r:system rexcmd[*tt;inp;t;"python3 s/$s/${s}.py $n"]+"|grep returnvalue=0\$"
    ?[r=0;:;[d[s]:x-1;say d;:r]];d[s]:x;r}/[0=;0;rg r]];say s,r}.'+(!;.)@`all;"o/n"say""json d]
 :]

say n:(!rge)#d /the n for this round

/here is where the real work happens
want:(" "\"suite imp starttime returnvalue walltime cputime memory"),tr:"terminationreason"
src:{[s;x]*{isfile'x}#"s/$s/$s."+x 1};dif:{[f;s;n]system"diff $f o/$s-$n-check"};tim:{?["e"~@x:stat[x];0;x"mtime"]};um:"unixmicro";tu:{time[x]}
flt:{k:!x;r:@[k;&k="exitsignal";:;"returnvalue"]!. x;?[tr in!r;r;r,(,tr)!,""]}
t6:{[u;t;s;n;i;x;f]gens:gen s;inp:?[s in!gen;"o/$gens-$n";"/dev/null"];?[(i="gcc")&~""~f;assert 0=system"gcc $gcco $f -oo/t";:]
   bn:src[s;x];cmd:?[i="gcc";?[f;"./o/t";"./o/$s"];call[i]@?[f;f;bn]]
   arg:?[s in!gen;"";$*/n#2];u say ""json("suite""imp"!(s;i)),flt out:rex[tt 1;inp;t;"$cmd $arg"];flush u;assert(~"e"=@out);(tr in!out)or "i"$out["returnvalue"]}
/eg run1[suite;imp;file] ./run -1 knucleotide goal knucleotide.goal
run1:{[s;i;f]t:{[s;i|x]t6[STDOUT;t:tmp 0;s;n s;i;imp i;x];t};a:t[""];b:t[f];assert 0=dif[b;s;n s];rm'a,b}
?["-1"in ARGS;run1 . (1+ARGS?"-1")_ARGS;[l:()
 {[s;n]
  {[s;n|i;x]?[bn:src[s;x];:;:1];?[tim[v:*|l,:"o/$s-$n-$i-run"]<tim bn;:;:1];w:"w"open tw:tmp"";
            ?[i="gcc";(tim["o/$s"]<tim bn)and system"gcc $gcco $bn -oo/$s";:] /compile c program
   r:{[s;n;i;x;w|;j]t:tmp 0;r:(0=dif[t;s;n]),0=t6[w;t;s;n;i;x;""];rm t;r}/[{((tt[1]*1e6)>tu[um]-x)&1=&/y}tu um;1;!15]
   assert@=/r;close w;bash"mv $tw $v"}.'+(!;.)@`imp}.'+(!;.)@`n
 /convert the output to a csv
 ?["r1"in ARGS;"r1.csv";"index.csv"]say"\n"/","/(,want),+.{((rx/(.*[0-9])[Bs]$/x)1)or x}''want!+,/{{(json x)[want]}'=-read x}'l
]]
"GOAMD64=v3 go build -o /path/to/bin/goal -tags full ./cmd/goal"
