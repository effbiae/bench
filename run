#!/usr/bin/env goal
/implementations with executable name and file extensions
imp:..[gcc:("gcc";"c");growler:("k";"growler.k");python3:("python3";"py");goal:("goal";"goal");bqn:("bqn";"bqn")]
rge:..[knucleotide:20 24;nbody:18 26] /the ranges for n (size of input/argument to each benchmark)
gen:..[knucleotide:"fasta"] /what program generates input
gcco:"-pipe -Wall -O3 -fomit-frame-pointer -march=native -fopenmp"
corescmd:rq#cat $(find /sys/devices/system/cpu -regex ".*cpu[0-9]+/topology/thread_siblings_list") |sort -n |uniq |cut -d, -f1#
bash:{say x;run"bash""-c",x}
say"cores "+cores:","/=-bash corescmd
system:{?["e"~@x:bash x;(.x)..code;0]};isfile:{~"e"=@x:stat x};isdir:{(~"e"=@x:stat x)and x"dir"}
rexcmd:{[t;input;output;argv]
 "runexec --walltimelimit ${t}s --memlimit 1GB  --cores $cores --input $input --output >(tail +7 >$output) -- $argv"}
rex:{[t;input;output;argv]bash rexcmd[t;input;output;argv]}

"imp.json"say""json imp /write imp for use in plot

?[isdir"o";::;mkdir"o"]
{(isfile"o/$x")or system"gcc $gcco s/$x/${x}.c -oo/$x"}'.gen /compile gcc programs

/generate input for benchmarks that need it
rg:{(*x)_!*|x};tmp:{-run"mktemp"};rm:{bash"rm "+x}

{[s;r]isfile["o/$s"]or system"gcc $gcco s/$s/${s}.c -oo/$s"
 {[s|i]n:$*/i#2;check:"$s-$i-check";inp:"/dev/null"
  ?[s in !gen;(gi:gen[s]+"-$i";inp:"o/$gi";(isfile ogi:"o/$gi")or rex[5;"/dev/null";ogi;"o/"+gen[s]+" $n"]);::]
  (isfile"o/$check")or rex[5;inp;"o/$check";"o/$s $n"]}'rg r}.'+(!;.)@`rge

/run the python benchmarks with increasing n until python takes longer than 5s (writes json to o/n)
d:(0#"")!!0
?[isfile"o/n";:
 [{[s;r]{[s|;x]n:*/x#2;inp:?[s in !gen;"o/"+gen[s]+"-$x";"/dev/null"];t:tmp 0
   r:system rexcmd[5;inp;t;"python3 s/$s/${s}.py $n"]+"|grep returnvalue=0\$"
   ?[r=0;[(0=system"diff $t o/$s-$x-check")or 1+"match";rm t];[d[s]:x-1;say d;:r]];rm t;r}/[0=;0;rg r]}.'+(!;.)@`rge
   "o/n"say""json d]]

say n:"i"$json read "o/n" /read the n for each suite

/here is where the real work happens

o:"o/run.out";u:"w"open"$o"
{[s;n]
 {[s;n|i;x]
  {[s;n;i;x|j]gens:gen s;inp:?[s in !gen;"o/$gens-$n";"/dev/null"]
   exe:*x;ext:?[i="gcc";"";"."+x 1];bn:"$s$ext";cmd:?[i="gcc";"./o/$s";"$exe s/$s/$bn"];arg:?[s in !gen;"";$*/n#2]
   u say"suite=$s\nimp=$i";t:tmp 0;u print rex[30;inp;t;"$cmd $arg"];u say"--";flush u
   ?[(0=j)&"e"~@e:bash"diff $t o/$s-$n-check";[say e;1+"fail"];:];rm t}'!5}.'+(!;.)@`imp}.'+(!;.)@`n

/convert the output to a csv
"run.csv"say"\n"/","/{(,**x),@[;1]'x}@+'"="\'{{((rx/(.*[0-9])[Bs]$/ x)1) or x}''x}@=-1_'-1_"--\n"\read o
